        "name": "Naar InfluxDB (licht)",
        "func": "// bouw de tekstregel die InfluxDB verwacht: meting,tag veld=waarde\nmsg.payload = `light,source=sensor lux=${msg.payload.lux}`;\n\n// waar en met welke sleutel we mogen schrijven, komt uit environment variabelen\nmsg.url = `${env.get(\"INFLUX_URL\")}/api/v2/write?org=${env.get(\"INFLUX_ORG\")}&bucket=${env.get(\"INFLUX_BUCKET\")}&precision=s`;\nmsg.headers = {\n    \"Authorization\": `Token ${env.get(\"INFLUX_TOKEN\")}`,\n    \"Content-Type\": \"text/plain; charset=utf-8\"\n};\n\nreturn msg;",
