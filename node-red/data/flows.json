    {
        "id": "2b333584fc7b2a1e",
        "type": "function",
        "z": "9b396b15101d0636",
        "name": "Valideer afstand",
        "func": "// msg.payload kan al een object zijn (auto-detect), of nog tekst -- we vangen beide op\nlet data = msg.payload;\nif (typeof data === \"string\") {\n    data = JSON.parse(data);\n}\n\n// enkel afstanden tussen 0 en 400 cm zijn geldig (meetbereik van de sensor)\nif (data.distance_cm >= 0 && data.distance_cm <= 400) {\n    msg.payload = data;\n    return [msg, null];   // uitgang 1: geldige meting\n} else {\n    return [null, msg];   // uitgang 2: ongeldige meting\n}",
        "outputs": 2,
