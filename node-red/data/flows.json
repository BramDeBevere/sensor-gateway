    {
        "id": "942f82e4e385453a",
        "type": "function",
        "z": "9b396b15101d0636",
        "name": "Naar InfluxDB (afstand)",
        "func": "// bouw de tekstregel die InfluxDB verwacht: meting,tag veld=waarde\nmsg.payload = `distance,source=sensor distance_cm=${msg.payload.distance_cm}`;\n\n// waar en met welke sleutel we mogen schrijven, komt uit environment variabelen\n// (ingesteld in docker-compose.yml, niet hardcoded hier)\nmsg.url = `${env.get(\"INFLUX_URL\")}/api/v2/write?org=${env.get(\"INFLUX_ORG\")}&bucket=${env.get(\"INFLUX_BUCKET\")}&precision=s`;\nmsg.headers = {\n    \"Authorization\": `Token ${env.get(\"INFLUX_TOKEN\")}`,\n    \"Content-Type\": \"text/plain; charset=utf-8\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 670,
        "y": 40,
        "wires": [
